# Application Environment (development, staging, production)
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/caregraph

# Frontend Service Configuration
API_BASE_URL=http://127.0.0.1:8000

# Security & Authentication
JWT_SECRET=YOUR_32_BYTE_HEX_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Initial Demo Data Seeding (set to true only for dev/testing environments; false in production)
SEED_DEMO_DATA=false

# LLM & Model Routing Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Telemetry & Observability
TELEMETRY_ENABLED=true
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=caregraph-ai
LANGCHAIN_API_KEY=your_langchain_api_key_here

